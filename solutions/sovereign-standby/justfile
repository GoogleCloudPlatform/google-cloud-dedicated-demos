set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Interactively configure environment directories and defaults.yaml files (pass --dry to preview manual steps)
init-config *args:
    python3 scripts/configure.py {{args}}

# Validate environment configurations and cross-network matching
check-config:
    python3 scripts/check_config.py

# Promote replica database to standalone primary (pass --dry to preview manual command)
promote *args:
    python3 scripts/promote.py {{args}}

# Cleanly destroy resources for a specified environment (gcd or gcp). Pass --k8s-only for K8s only, pass --dry to preview manual commands.
destroy *args:
    python3 scripts/destroy.py {{args}}

# Reset/destroy only Kubernetes workloads and namespaces (pass --dry to preview manual commands)
destroy-k8s *args:
    python3 scripts/destroy.py {{args}} --k8s-only

# Lint Helm charts in k8s/helm/
helm-lint:
    @for chart in k8s/helm/*/; do echo "== Linting $chart =="; helm lint "$chart"; done

lint: helm-lint
    pre-commit run --all-files --show-diff-on-failure
