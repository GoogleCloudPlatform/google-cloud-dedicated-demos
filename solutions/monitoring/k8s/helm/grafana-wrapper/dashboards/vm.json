    {
      "id": 4,
      "title": "Per-Core CPU Utilization (4 Cores)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-datasource"
          },
          "editorMode": "code",
          "expr": "sum by (cpu) (rate(system_cpu_time{cpu!=\"total\", state!=\"idle\"}[2m])) * 100",
